{
    "name": "vm-panel",
    "version": "0.1.0",
    "description": "VM-Panel â€” VM deployment manager (fresh system; desain: docs/DESIGN.md)",
    "type": "module",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=20"
    },
    "main": "manager/index.js",
    "bin": {
        "vmctl": "./bin/vmctl.js",
        "connect-vps": "./bin/connect-vps.js"
    },
    "scripts": {
        "ssh": "node bin/connect-vps.js",
        "ssh:vscode": "node bin/connect-vps.js --vscode",
        "ssh:info": "node bin/connect-vps.js --info",
        "test": "node --test tests/unit/*.test.js",
        "test:unit": "node --test tests/unit/*.test.js",
        "test:integration": "node --test tests/integration/*.test.js",
        "test:security": "node --test tests/security/*.test.js",
        "test:recovery": "node --test tests/recovery/*.test.js",
        "start": "node start-all.mjs",
        "start:manager": "node manager/index.js",
        "stop": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 8097 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }\""
    },
    "dependencies": {
        "better-sqlite3": "11.10.0"
    },
    "author": "VM-Panel"
}

