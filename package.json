{
    "name": "vm-panel",
    "version": "0.1.0",
    "description": "VM-Panel â€” VM deployment manager (fresh system; desain: docs/DESIGN.md)",
    "type": "module",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=20"
    },
    "main": "desktop/main.js",
    "bin": {
        "vmctl": "./bin/vmctl.js"
    },
    "scripts": {
        "test": "node --test tests/unit/*.test.js",
        "test:unit": "node --test tests/unit/*.test.js",
        "test:integration": "node --test tests/integration/*.test.js",
        "test:security": "node --test tests/security/*.test.js",
        "test:recovery": "node --test tests/recovery/*.test.js",
        "start": "node start-all.mjs",
        "start:panel": "node panel/server/index.js",
        "start:manager": "node manager/index.js",
        "stop": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 8097,8080 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }\"",
        "desktop": "electron desktop/main.js",
        "desktop:build": "electron-builder --dir",
        "desktop:dist": "electron-builder --win",
        "shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1"
    },
    "dependencies": {
        "better-sqlite3": "11.10.0"
    },
    "author": "VM-Panel",
    "devDependencies": {
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "appId": "com.vmpanel.desktop",
        "productName": "VM-Panel",
        "npmRebuild": false,
        "asar": false,
        "directories": {
            "output": "dist"
        },
        "files": [
            "**/*",
            "!dist/**",
            "!tests/**",
            "!.git/**"
        ],
        "win": {
            "target": "dir",
            "icon": "desktop/assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
