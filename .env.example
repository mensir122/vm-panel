# VM-Panel — environment variables (CONTOH/PLACEHOLDER SAJA).
# .env tidak pernah di-commit; nilai asli tidak pernah di-hardcode.

# Master key untuk encrypt vault (secrets/vault.enc).
# WAJIB diganti dengan string acak minimal 32 karakter di mesin lokal.
VPANEL_MASTER_KEY=change-me-min-32-chars

# Environment runtime: dev | actions | vps | container.
VM_PANEL_ENV=dev

# Port internal Manager API.
MANAGER_API_PORT=8097

# Port HTTP panel.
PANEL_PORT=8080
